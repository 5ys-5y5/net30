{
  "name": "net30-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run validate:design",
    "dev": "node scripts/dev-all.mjs",
    "predev:storefront": "npm run validate:design",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "npm run validate:design",
    "build": "npm run typecheck && vite build",
    "prepreview": "npm run validate:design",
    "preview": "vite preview --host 127.0.0.1",
    "dev:host": "node scripts/dev-all.mjs",
    "dev:storefront": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "validate:design": "npm --prefix ../docs/design-system run validate",
    "proof:design": "npm --prefix ../docs/design-system run proof"
  },
  "dependencies": {
    "cobe": "^2.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
